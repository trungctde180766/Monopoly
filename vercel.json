{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health.js"
    },
    {
      "source": "/api/realtime/socket.io/(.*)",
      "destination": "/api/realtime.js"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "/api/realtime.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!assets/|favicon\\.svg|icons\\.svg).*)$",
      "destination": "/index.html"
    }
  ]
}
