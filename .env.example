# Để trống khi frontend/API cùng project Vercel hoặc khi chạy toàn bộ server local.
VITE_SOCKET_URL=
VITE_SOCKET_PATH=/socket.io

# Chỉ đặt ở backend / Vercel Environment Variables; không dùng tiền tố VITE_ cho Redis.
# Dùng TCP URL (có TLS khi nhà cung cấp yêu cầu), không dùng UPSTASH_REDIS_REST_URL.
# REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_REDIS_HOST:6379
REDIS_KEY_PREFIX=cotyphu
# Local không có REDIS_URL dùng file store. Vercel thiếu REDIS_URL trả 503 cho online.

# Chỉ cho test Redis trên máy; dùng database thử nghiệm riêng.
# REDIS_TEST_URL=redis://127.0.0.1:16389

