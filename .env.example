# URL của máy chủ Socket.io Backend (nếu deploy riêng Frontend trên Vercel)
# Ví dụ: VITE_SOCKET_URL=https://monopoly-vietnam.onrender.com
# Nếu để trống, frontend sẽ tự động kết nối tới domain hiện tại (dành cho Render / Railway / Localhost).
VITE_SOCKET_URL=
# Backend hiện tại dùng path mặc định này. Đổi cùng server nếu dùng endpoint khác.
VITE_SOCKET_PATH=/socket.io

